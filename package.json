{
  "name": "kidslearningapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "illustrations": "node scripts/build-illustrations.mjs",
    "cap:sync": "npm run build && cap sync android",
    "android:run": "npm run build && cap run android",
    "android:bundle": "npm run build && cap sync android && cd android && gradlew.bat bundleRelease",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@capacitor/cli": "^8.5.3",
    "@iconify-json/fluent-emoji-flat": "1.2.6",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.56.1"
    }
  }
}
